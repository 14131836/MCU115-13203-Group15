<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#17171C"
    tools:context=".MainActivity">

    <!-- 頂部顯示區域 -->
    <TextView
        android:id="@+id/tv_expression"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingHorizontal="32dp"
        android:paddingTop="32dp"
        android:text=""
        android:textColor="#80FFFFFF"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_display"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_display"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end|bottom"
        android:paddingHorizontal="32dp"
        android:paddingBottom="16dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="80sp"
        app:layout_constraintBottom_toTopOf="@+id/gl_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_expression" />

    <!-- 按鈕網格區域 -->
    <GridLayout
        android:id="@+id/gl_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:padding="8dp"
        android:rowCount="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 第一排 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ac"
            android:text="AC"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_c"
            android:text="C"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_backspace"
            android:text="⌫"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FF5252"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_div"
            android:text="÷"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#4CAF50"
            android:textSize="32sp" />

        <!-- 第二排 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_7"
            android:text="7"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_8"
            android:text="8"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_9"
            android:text="9"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mul"
            android:text="×"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#4CAF50"
            android:textSize="32sp" />

        <!-- 第三排 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_4"
            android:text="4"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_5"
            android:text="5"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_6"
            android:text="6"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sub"
            android:text="-"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#4CAF50"
            android:textSize="32sp" />

        <!-- 第四排 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_1"
            android:text="1"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_2"
            android:text="2"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_3"
            android:text="3"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add"
            android:text="+"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#4CAF50"
            android:textSize="32sp" />

        <!-- 第五排 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dot"
            android:text="."
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_0"
            android:text="0"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="#2E2F3E"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_equal"
            android:text="="
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_margin="4dp"
            android:layout_gravity="fill_horizontal"
            app:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
